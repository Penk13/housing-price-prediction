<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36" pages="2">
  <diagram name="Page-1" id="5_WF_WkkmAxbjKLKCoqw">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uJq97GZcK3yLcx4jjehO-19" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="1. Download Data" vertex="1">
          <mxGeometry height="500" width="720" x="160" y="-350" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-6" parent="uJq97GZcK3yLcx4jjehO-19" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;1.3 Create test set (use StratifiedSampling)&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Create new column &quot;income_category&quot;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;for&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;stratified sampling (&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;use&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;train_test_split)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;and remove it again after it&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;Output:&amp;nbsp;&lt;/div&gt;&lt;div&gt;strat_train_set&lt;/div&gt;&lt;div&gt;strat_test_set&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="370" width="293" x="400" y="50" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-5" parent="uJq97GZcK3yLcx4jjehO-19" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;1.2 Quick look at the data&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div style=&quot;text-align: left;&quot;&gt;head() &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;: display the first 5 data/rows&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;info() &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;: display info&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;(column name, non-null count, type)&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;value_counts() : count categorical data&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;describe() &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;: display statistical summary&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;(count, mean, std, min, 25%, 50%, 75%, max)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;hist()&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;: display plot&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="360" x="20" y="330" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-3" parent="uJq97GZcK3yLcx4jjehO-19" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;" value="&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.1&amp;nbsp;Download data from github&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Download from this:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;https://github.com/ageron/data/raw/main/housing.tgz&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Output: housing_data&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;*The shape of housing_data is (20640,10)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="360" x="20" y="50" as="geometry" />
        </mxCell>
        <mxCell id="IJKKCWVvwldR9SQUMgZK-8" parent="uJq97GZcK3yLcx4jjehO-19" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="175.95" width="232.83" x="430.09000000000003" y="200" as="geometry" />
        </mxCell>
        <mxCell id="eJzn4f_GXO8o0YQ_i6Yk-8" parent="uJq97GZcK3yLcx4jjehO-19" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="138" width="234.36" x="82.82" y="160" as="geometry" />
        </mxCell>
        <mxCell id="fgyKif_dty_0OgXbhiXW-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="2. Explore and Visualize the Data to Gain Insight" vertex="1">
          <mxGeometry height="410" width="850" x="160" y="180" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-8" parent="fgyKif_dty_0OgXbhiXW-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;2.1 Visualizing geographical data&lt;/b&gt;&lt;div&gt;Insight:&amp;nbsp;&lt;/div&gt;&lt;div&gt;Housing price are related to the location and population density (close to ocean and higher population tend to have higher prices)&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="250" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-9" parent="fgyKif_dty_0OgXbhiXW-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;2.2 Look for correlations&lt;/b&gt;&lt;div&gt;Insight:&lt;/div&gt;&lt;div&gt;Median income is the most promising attribute to predict housing median value&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="230" x="290" y="150" as="geometry" />
        </mxCell>
        <mxCell id="uJq97GZcK3yLcx4jjehO-10" parent="fgyKif_dty_0OgXbhiXW-1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;" value="&lt;b&gt;2.3 Experiment with attribute combinations&lt;/b&gt;&lt;div&gt;Insight:&lt;/div&gt;&lt;div&gt;We can combine some attributes to make it more useful (room_per_household, bedroom_per_room, population_per_household)&lt;/div&gt;" vertex="1">
          <mxGeometry height="350" width="290" x="540" y="40" as="geometry" />
        </mxCell>
        <mxCell id="IJKKCWVvwldR9SQUMgZK-2" parent="fgyKif_dty_0OgXbhiXW-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="250" width="210.41" x="579.79" y="130" as="geometry" />
        </mxCell>
        <mxCell id="IJKKCWVvwldR9SQUMgZK-3" parent="fgyKif_dty_0OgXbhiXW-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="140" width="201.68" x="304.16" y="230" as="geometry" />
        </mxCell>
        <mxCell id="IJKKCWVvwldR9SQUMgZK-4" parent="fgyKif_dty_0OgXbhiXW-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="160" width="218.13" x="35.94" y="210" as="geometry" />
        </mxCell>
        <mxCell id="fgyKif_dty_0OgXbhiXW-2" parent="fgyKif_dty_0OgXbhiXW-1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;*Use strat_train_set_copy&lt;/div&gt;strat_train_set_copy = strat_train_set.copy()" vertex="1">
          <mxGeometry height="60" width="250" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="fgyKif_dty_0OgXbhiXW-3" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="3. Prepare the Data for Machine Learning" vertex="1">
          <mxGeometry height="520" width="1300" x="160" y="620" as="geometry" />
        </mxCell>
        <mxCell id="eJzn4f_GXO8o0YQ_i6Yk-9" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;*Separate the predictors and the labels&lt;/div&gt;strat_train_set_copy (without median_house_value)&lt;div&gt;strat_train_set_copy_labels (only median_house_value)&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="eJzn4f_GXO8o0YQ_i6Yk-12" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;3.1 Set the missing value (SimpleImputer)&lt;/b&gt;&lt;div&gt;Data has some missing values (total_bedrooms)&lt;/div&gt;&lt;div&gt;Solution:&lt;/div&gt;&lt;div&gt;Set the missing values with median value&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we set the missing value of total_bedrooms with its median value&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="q7JXc50IBTTTKURIs8pN-1" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;3.2 - Handling text and categorical attributes (OneHotEncoder)&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;strat_train_set_copy_category (only ocean_proximity)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Most ML algorithms prefer number over category/text&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Solution:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Convert to binary and set the current value to 1 and the other to 0&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we use OneHotEncoder for ocean_proximity column&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="380" x="20" y="260" as="geometry" />
        </mxCell>
        <mxCell id="q7JXc50IBTTTKURIs8pN-4" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;3.3 - Feature scaling and transformation (Min-max scaling &amp;amp; Standardization)&lt;/b&gt;&lt;div&gt;&lt;div&gt;Most ML algorithms don&#39;t work well with data with very different scale&lt;/div&gt;&lt;div&gt;Solution:&lt;/div&gt;&lt;div&gt;min-max scaling : rescale the value to be between 0 and 1&lt;/div&gt;&lt;div&gt;standardization : it substract the mean and divides by standard deviation (much less affected by outliers)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="410" x="380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="q7JXc50IBTTTKURIs8pN-6" parent="fgyKif_dty_0OgXbhiXW-3" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="107" width="202.41" x="108.8" y="350" as="geometry" />
        </mxCell>
        <mxCell id="UZT80tRYi7imKbfjbBPn-2" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;3.5 - Handle population (FunctionTransformer)&lt;/b&gt;&lt;div&gt;Sometimes there is no built-in function available for our problem&lt;/div&gt;&lt;div&gt;Solution:&lt;/div&gt;&lt;div&gt;Create a custom function and wrap it using FunctionTransformer&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we use FunctionTransformer with np.log to transform population column&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="830" y="40" as="geometry" />
        </mxCell>
        <mxCell id="UZT80tRYi7imKbfjbBPn-3" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;3.6 - Handle latitude and longtitude with CustomTransfermer (KMeans)&lt;/b&gt;&lt;div&gt;Sometimes we want it to be trainable&lt;/div&gt;&lt;div&gt;Solution:&lt;/div&gt;&lt;div&gt;Create a new class that has method fit() and transform()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we create custom class ClusterSimilarity to meassure similarity between district using KMeans (apply it to latitude and longtitude column)&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="450" x="830" y="200" as="geometry" />
        </mxCell>
        <mxCell id="XIA49ryQhfzcA2qfa85B-1" parent="fgyKif_dty_0OgXbhiXW-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;3.4 -&amp;nbsp;Feature transformation (log, RBF, TransformedTargetRegressor&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;Most ML algorithms don&#39;t work well with data with heavy tail&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Solution:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Replace value with its log&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Bucketize&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- For multimodal distribution, use RBF&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we apply:&lt;br&gt;- log transformation for population column,&lt;br&gt;- RBF for housing_median_age column,&lt;br&gt;- use&amp;nbsp;TransformedTargetRegressor for median_income column&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="360" x="430" y="200" as="geometry" />
        </mxCell>
        <mxCell id="q7JXc50IBTTTKURIs8pN-5" parent="fgyKif_dty_0OgXbhiXW-3" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="109.23" width="308" x="456" y="310.77" as="geometry" />
        </mxCell>
        <mxCell id="XIA49ryQhfzcA2qfa85B-28" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="4. Use Pipeline to Combine All" vertex="1">
          <mxGeometry height="330" width="920" x="160" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="XIA49ryQhfzcA2qfa85B-30" parent="XIA49ryQhfzcA2qfa85B-28" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;4.1 - Pipeline and make_pipeline&lt;/b&gt;&lt;div&gt;A class to chain multiple data processing steps&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we create some pipelines:&lt;div style=&quot;text-align: left;&quot;&gt;1. ratio_pipeline :&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;impute with median &amp;gt; custom function ratio &amp;gt; standardization&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. log_pipeline :&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;impute with median &amp;gt; custom function log &amp;gt; standardization&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;3. cat_pipeline:&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;impute with most frequent &amp;gt; use OneHotEncoder&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;4. default_num_pipeline :&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;impute with median &amp;gt; standardization&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="350" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="XIA49ryQhfzcA2qfa85B-38" parent="XIA49ryQhfzcA2qfa85B-28" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;4.2 - ColumnTransformer and make_column_transformer&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A class to apply preprocessing to different columns&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we create ColumnTransformer with:&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. bedrooms : ratio_pipeline (total_bedrooms, total_rooms)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. rooms_per_house : ratio_pipeline (total_rooms, households)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;3. people_per_house : ratio_pipeline (population, households)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;4. log : log_pipeline (total_bedrooms, total_rooms, population, households, median_income)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;5. geo : cluster_similarity (latitude, longtitude)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;6. cat : cat_pipeline (column with type obj)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;7. remainder: default_num_pipeline (housing_median_age)&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="510" x="390" y="40" as="geometry" />
        </mxCell>
        <mxCell id="IinlJV1UAPTaDMyehEQp-3" parent="XIA49ryQhfzcA2qfa85B-28" style="rounded=0;whiteSpace=wrap;html=1;" value="*We apply the full_pipeline to&amp;nbsp;strat_train_set_copy&lt;div&gt;After applying, the total column increase from 9 to 24&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="300" x="20" y="250" as="geometry" />
        </mxCell>
        <mxCell id="4H-Ln78rtRkw-ePsD6EZ-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="5. Select and Train a Model" vertex="1">
          <mxGeometry height="360" width="840" x="160" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="4H-Ln78rtRkw-ePsD6EZ-2" parent="4H-Ln78rtRkw-ePsD6EZ-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;5.1 - LinearRegression&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Step:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Make pipeline consist of full_pipeline and LinearRegression&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Apply that pipeline to strat_train_set_copy and strat_train_set_copy_labels&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. See the result and count the RMSE&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we can see the model is underfitting&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="390" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="4H-Ln78rtRkw-ePsD6EZ-5" parent="4H-Ln78rtRkw-ePsD6EZ-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;5.2 - DecisionTreeRegressor&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Step:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Make pipeline consist of full_pipeline and DecisionTreeRegressor&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Apply that pipeline to strat_train_set_copy and strat_train_set_copy_labels&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. See the result and count the RMSE&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we can see the model is overfitting&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="390" x="430" y="40" as="geometry" />
        </mxCell>
        <mxCell id="vsLBVsUJ3iKuDaRDwi1W-1" parent="4H-Ln78rtRkw-ePsD6EZ-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;5.3 - Cross Validation&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;Randomly split the training set into some nonoverlaping subsets called folds then trains and evaluates with every different folds&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we use 10x cross validation on DecisionTree algorithm and found the RMSE is pretty high. This means the model is overfitting, because on training set it perform perfectly while on validation set it perform poorly.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="390" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vsLBVsUJ3iKuDaRDwi1W-2" parent="4H-Ln78rtRkw-ePsD6EZ-1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;5.4 - RandomForestRegressor&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Step:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1. Make pipeline consist of full_pipeline and RandomForestRegressor&lt;/div&gt;&lt;div&gt;2. Apply that pipeline to strat_train_set_copy and strat_train_set_copy_labels&lt;/div&gt;&lt;/div&gt;&lt;div&gt;3. See the result and count the RMSE&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;*In this project, we can see the model is much better than all the previous one&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="390" x="430" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vsLBVsUJ3iKuDaRDwi1W-3" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="6. Fine-Tune the Model" vertex="1">
          <mxGeometry height="380" width="840" x="160" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="vsLBVsUJ3iKuDaRDwi1W-4" parent="vsLBVsUJ3iKuDaRDwi1W-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;6.1 - GridSearchCV&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;Automatically run many combinations to search for best combinations of hyperparameter&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Step:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Create final_pipeline (combination of full_pipeline and the predictor)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Create a list of hyperparameter that you want to experiment&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. Determine cross validation folds and scoring method&lt;/div&gt;&lt;div style=&quot;&quot;&gt;4. Apply it to the training data and training labels&lt;/div&gt;&lt;div style=&quot;&quot;&gt;5. See the result&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we try 3x(9+5) combinations, so total 45 combinations&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="390" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="8Fz1Z3hPhKbwBLr2eAT3-1" parent="vsLBVsUJ3iKuDaRDwi1W-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;6.2 - RandomizedSearchCV&lt;/b&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;Try random combinations from range of possible values, allowing explore a wider search space faster&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Step:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Create final_pipeline (combination of full_pipeline and the predictor)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Create a param distributions (range of possible values)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. Determine cross validation folds, iterations, and scoring method&lt;/div&gt;&lt;div style=&quot;&quot;&gt;4. Apply it to the training data and training labels&lt;/div&gt;&lt;div style=&quot;&quot;&gt;5. See the result&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;*In this project, we try 3x10 combinations, so total 30 combinations&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="390" x="430" y="40" as="geometry" />
        </mxCell>
        <mxCell id="LF2CnRNAviu0O656_bEJ-1" parent="vsLBVsUJ3iKuDaRDwi1W-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;6.3 - Analyze the Best Model&lt;/b&gt;&lt;div&gt;Step:&lt;br&gt;&lt;div&gt;1. See which feature is important, drop the less useful feature&lt;/div&gt;&lt;div&gt;2. Try to look at specific errors and how to fix them:&amp;nbsp;&lt;/div&gt;&lt;div&gt;Add feature, remove feature, clean outliers, etc.&lt;/div&gt;&lt;/div&gt;&lt;div&gt;3. Ensure the model works on all categories:&lt;/div&gt;&lt;div&gt;Rural or urban, rich or poor, northern or southern, etc.&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="390" x="20" y="240" as="geometry" />
        </mxCell>
        <mxCell id="LF2CnRNAviu0O656_bEJ-2" parent="vsLBVsUJ3iKuDaRDwi1W-3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="&lt;b&gt;6.4 - Evaluate on the Test Set&lt;/b&gt;&lt;div&gt;Step:&lt;/div&gt;&lt;div&gt;1. Prepare the test set&lt;/div&gt;&lt;div&gt;2. Predict on the test set and see the result&lt;/div&gt;&lt;div&gt;3. Compute confidence interval&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="390" x="430" y="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
